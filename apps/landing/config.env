# Non-secret settings for the landing page's backend (reviews + feedback).
# ${LANDING_API_HOST} and ${LANDING_ORIGINS} are filled in by Flux from clusters/production/cluster-settings.yaml.
# The landing page itself stays on Vercel; this is only the small API it calls.

DJANGO_ALLOWED_HOSTS=${LANDING_API_HOST},localhost
# Browsers may only call this API from these origins (your landing page's address(es)).
CORS_ALLOWED_ORIGINS=${LANDING_ORIGINS}
CSRF_TRUSTED_ORIGINS=https://${LANDING_API_HOST}
DJANGO_SECURE_SSL_REDIRECT=true
RUN_MIGRATIONS_ON_BOOT=false
