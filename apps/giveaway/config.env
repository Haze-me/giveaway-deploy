# Non-secret settings for the giveaway backend and workers.
# ${APP_HOST}, ${FROM_EMAIL} and ${ALERT_EMAIL} are filled in by Flux from clusters/production/cluster-settings.yaml.
# Secret values (keys, passwords, DATABASE_URL) are NOT here: see secrets/ and docs/BUILD-RUNBOOK.md.

# --- web ---------------------------------------------------------------------------------
# "localhost" is also allowed so the Kubernetes health checks (which call the pod directly) pass.
# ${LANDING_API_HOST} is the landing page's feedback API, now served by this backend.
DJANGO_ALLOWED_HOSTS=${APP_HOST},${LANDING_API_HOST},localhost
# ${LANDING_ORIGINS} lets the landing page (on Vercel) call /api/v1/feedback/ from the browser.
CORS_ALLOWED_ORIGINS=https://${APP_HOST},${LANDING_ORIGINS}
CSRF_TRUSTED_ORIGINS=https://${APP_HOST}
FRONTEND_BASE_URL=https://${APP_HOST}
DJANGO_SECURE_SSL_REDIRECT=true
# Migrations run in a dedicated init step before each release (see backend.yaml), not on every boot.
RUN_MIGRATIONS_ON_BOOT=false

# --- email -------------------------------------------------------------------------------
EMAIL_BACKEND=apps.core.email_backends.ResendBackend
DEFAULT_FROM_EMAIL=${FROM_EMAIL}
RESEND_SENDER_EMAIL=${FROM_EMAIL}
PAYOUT_ALERT_EMAIL=${ALERT_EMAIL}

# --- money switches ----------------------------------------------------------------------
# Changing these is a normal reviewed commit: edit, push, and Flux restarts the app on the new
# values. Turn them on in this order after the live rehearsal (docs/BUILD-RUNBOOK.md, step 14):
#   1. the live VTpass wallet is funded and `vtpass_smoke` has passed
#   2. PAYOUTS_ENABLED=true        (winners are paid)
#   3. PRIZE_REFUNDS_ENABLED=true  (cancel-and-refund and unspent-prize refunds)
EVENT_FEE_ENABLED=false
EVENT_FEE_KOBO=50000
PRIZE_FUNDING_REQUIRED=true
PRIZE_FUNDING_PASS_FEE=true
VTPASS_FAKE=false
VTPASS_BASE_URL=https://vtpass.com/api
PAYOUTS_ENABLED=false
PRIZE_REFUNDS_ENABLED=true
STALE_DRAFT_REFUND_DAYS=7
REFUND_DELAY_MINUTES=60
WALLET_LOW_FLOOR_KOBO=50000
